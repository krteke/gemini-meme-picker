{
  "name": "gemini-meme-picker",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Cross-browser (Chrome & Firefox) native meme & sticker drawer extension for Google Gemini Web.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox-mv3": "wxt build -b firefox --mv3",
    "build:all": "wxt build && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "presets:sync": "node scripts/build-presets.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "gemini",
    "meme",
    "sticker",
    "wxt",
    "chrome-extension",
    "firefox-addon"
  ],
  "devDependencies": {
    "wxt": "^0.21.5"
  }
}
