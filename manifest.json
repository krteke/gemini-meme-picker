{
  "manifest_version": 3,
  "name": "Gemini Meme Picker",
  "version": "1.0.0",
  "description": "为 Google Gemini 网页端打造的原生聊天表情包抽屉与自定义图库扩展。",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Gemini Meme Picker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "src/styles.css"
      ],
      "js": [
        "src/storage.js",
        "src/gemini-adapter.js",
        "src/renderer.js",
        "src/picker.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/presets/*"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ]
}
